# Copy to .env (never commit .env). All values are optional; secrets are generated into var/ when unset.
DATABASE_URL=sqlite:///var/apaar.db           # PostgreSQL also works: postgresql+psycopg://user:pass@host/db
JWT_SECRET=                                   # generated into var/jwt_secret if empty
APAAR_HMAC_KEY=                               # pseudonymises APAAR IDs in logs (apaar_ref); generated if empty
TOKEN_MINUTES=120
PUBLIC_BASE_URL=http://localhost:8000         # used in credential status URLs and QR codes
CURRENT_ACADEMIC_YEAR=2026-27
SUBMISSION_DEADLINE=2026-11-30
APAAR_ADAPTER_MODE=simulated                  # simulated | unavailable (to demo R008); there is no live adapter
APP_ENV=development                           # set production only after official adapter, migrations and reviews exist
APAAR_SIM_OUTAGE=0                            # set 1 to exercise degraded simulated registry behavior
LOGIN_RATE_PER_MINUTE=30
VERIFY_RATE_PER_MINUTE=60
VERIFIER_REQUESTS_PER_HOUR=30
# APAAR_TODAY=2026-10-27                      # pin "today" for reproducible tests
# APAAR_VAR_DIR=/path/to/var                  # where keys, secrets and the SQLite file live (mode 0600 files)
